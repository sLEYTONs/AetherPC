##
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##

# User-specific
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Test / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# AetherPC local / publish output (binaries go on GitHub Releases)
dist/
**/AetherPC_Bench.tmp
*.db
*.db-shm
*.db-wal
*.log
*.sys

# Local secrets / env
.env
.env.*
*.pfx
*.snk
secrets.json
appsettings.*.local.json

# Tooling leftovers
tools/_recover/
tools/smoke-shots/
tools/**/shots/
**/createdump.exe

# OS / editor
.idea/
*.swp
*~
.DS_Store

# Inno / installer temps
installer/Output/
*.islu

# Publish / smoke leftovers
**/_normal-build/
**/_portable-build/
**/_boot-build/
**/_iscc-out/
**/InstallerOut/
