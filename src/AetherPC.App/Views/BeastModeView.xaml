<UserControl x:Class="AetherPC.App.Views.BeastModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:AetherPC.App.Services"
             xmlns:conv="clr-namespace:AetherPC.App.Converters">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:InverseBoolConverter x:Key="InvertBool" />
  </UserControl.Resources>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado Bestia -->
    <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}" BorderBrush="#66F0A202" BorderThickness="1"
            Visibility="{Binding IsPlanPhase, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Style="{StaticResource PageHeaderTextColumn}" Margin="0,0,12,0">
          <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Page.Beast]}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.Blurb]}" Style="{StaticResource PageBlurb}" />
          <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource BrushAccent}"
                     FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
          <ProgressBar Height="4" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,8,0,0" Foreground="#FFF0A202"
                       Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding PlanStats}" Foreground="{DynamicResource BrushOk}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="BtnAnalyze" Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.Analyze]}"
                  Style="{StaticResource HeaderActionButton}" Margin="0,0,6,0" Click="BtnAnalyze_OnClick"
                  IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvertBool}}" />
          <Button x:Name="BtnApply" Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.Apply]}"
                  Style="{StaticResource HeaderSuccessButton}" Click="BtnApply_OnClick"
                  Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}"
                  IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== FASE PLAN ========== -->
    <Grid Grid.Row="1" Visibility="{Binding IsPlanPhase, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="4,0,4,8"
                  Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.RecommendedHint]}"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,10" FontSize="12" />
        <WrapPanel>
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.FilterAll]}" Command="{Binding SetFilterCommand}" CommandParameter="all" Style="{StaticResource SortChipButton}" />
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.FilterCritical]}" Command="{Binding SetFilterCommand}" CommandParameter="critical" Style="{StaticResource SortChipButton}" />
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.FilterRecommended]}" Command="{Binding SetFilterCommand}" CommandParameter="recommended" Style="{StaticResource SortChipButton}" />
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.FilterOptional]}" Command="{Binding SetFilterCommand}" CommandParameter="optional" Style="{StaticResource SortChipButton}" />
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.FilterAdvanced]}" Command="{Binding SetFilterCommand}" CommandParameter="advanced" Style="{StaticResource SortChipButton}" />
        </WrapPanel>
        <DockPanel Margin="2,4,0,0" LastChildFill="False">
          <Button DockPanel.Dock="Left"
                  Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Optimize.SortGainBtn]}"
                  Command="{Binding ToggleSortByGainCommand}" Style="{StaticResource SortOptionButton}"
                  ToolTip="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Optimize.SortGainTip]}" />
          <Button DockPanel.Dock="Left"
                  Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.SelectAll]}"
                  Command="{Binding SelectAllVisibleCommand}" Style="{StaticResource ActionOptionButton}" />
        </DockPanel>
      </StackPanel>

      <Border Grid.Row="1" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource BrushSurface}" CornerRadius="12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="4">
        <ListBox ItemsSource="{Binding VisibleActions}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.PanningMode="VerticalOnly"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.IsContainerVirtualizable="True">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource BrushRow}" CornerRadius="10" Margin="4,3" Padding="12,10"
                      BorderBrush="#33F0A202" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,12,0" />
                  <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Background="#33F0A202" CornerRadius="6" Padding="7,2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding PriorityLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#FFF0A202" />
                      </Border>
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                 Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding SimpleWhat}" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource BrushSecondaryText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StateLine}" FontSize="12.5" Foreground="{DynamicResource BrushAccent}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                      <Border Background="#22000000" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                              BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}">
                        <TextBlock Text="{Binding RiskLabel}" FontSize="12" Foreground="{DynamicResource BrushMuted}" />
                      </Border>
                      <Border Background="#223BA4FF" CornerRadius="6" Padding="7,2" Margin="0,0,6,4">
                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource BrushAccent}" />
                      </Border>
                      <Border Background="#33F0A202" CornerRadius="6" Padding="7,2" Margin="0,0,6,4">
                        <TextBlock Text="{Binding PersistenceLabel}" FontSize="12" Foreground="#FFF0A202" />
                      </Border>
                      <Border Background="#221F6FEB" CornerRadius="6" Padding="7,2" Margin="0,0,6,4">
                        <TextBlock Text="{Binding ImpactLabel}" FontSize="12" Foreground="{DynamicResource BrushText}" />
                      </Border>
                      <Border Background="#22F0A202" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                              Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Admin" FontSize="12" Foreground="{DynamicResource BrushWarn}" />
                      </Border>
                      <Border Background="#33FF8C42" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                              Visibility="{Binding AffectsVisuals, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Meta.Visual]}" FontSize="12" Foreground="#FFFF8C42" />
                      </Border>
                      <Border Background="#33FF5C5C" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                              Visibility="{Binding AffectsConvenience, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Meta.Comfort]}" FontSize="12" Foreground="#FFFF5C5C" />
                      </Border>
                      <TextBlock Text="{Binding LastResult}" FontSize="12.5" Foreground="{DynamicResource BrushOk}"
                                 VerticalAlignment="Center" TextWrapping="Wrap"
                                 Visibility="{Binding LastResult, Converter={StaticResource NullToVis}}" />
                    </WrapPanel>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource ActionGainBadge}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding GainLabel}" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource BrushOk}" ToolTip="{Binding GainHint}" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Row="2" Background="{DynamicResource BrushFooter}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
              Padding="14,12" Margin="0,8,0,0" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.ApplyNow]}"
                  Style="{StaticResource HeaderSuccessButton}" Click="BtnApply_OnClick" Margin="12,0,0,0"
                  IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
          <CheckBox DockPanel.Dock="Right"
                    Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Optimize.CreateRp]}"
                    IsChecked="{Binding CreateRestorePoint}"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    Foreground="{DynamicResource BrushText}" />
          <!-- Restaurar sesión: a la izquierda del punto de restauración (no tapa Aplicar) -->
          <Button DockPanel.Dock="Right"
                  Width="40" Height="40" Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Style="{StaticResource BeastRestoreFab}"
                  Command="{Binding RestoreBeastSessionCommand}"
                  Visibility="{Binding HasActiveBeastSession, Converter={StaticResource BoolToVis}}"
                  ToolTip="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.RestoreTip]}">
            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="#FF121212" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ========== FASE APLICANDO (overlay a pantalla completa del área) ========== -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="20"
          Visibility="{Binding IsApplyingPhase, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource BrushBg}"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border MaxWidth="560" MinWidth="280" Margin="24"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{DynamicResource BrushSurface}" CornerRadius="18"
              BorderBrush="#66F0A202" BorderThickness="1" Padding="36,40">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#FF000000" />
        </Border.Effect>
        <StackPanel>
          <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,20"
                  Background="#22F0A202" BorderBrush="#FFF0A202" BorderThickness="2">
            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                       Foreground="#FFF0A202" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.ApplyingTitle]}"
                     FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushText}"
                     HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.ApplyingHint]}"
                     FontSize="13" Foreground="{DynamicResource BrushSecondaryText}"
                     HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,22" TextWrapping="Wrap" />

          <Grid Margin="0,0,0,10">
            <ProgressBar Height="10" Maximum="100" Value="{Binding ProgressPercent}"
                         Foreground="#FFF0A202" Background="{DynamicResource BrushRow}" />
          </Grid>
          <DockPanel Margin="0,0,0,18">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ApplyCountLabel}"
                       FontWeight="Bold" FontSize="13" Foreground="#FFF0A202" />
            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                       FontSize="13" Foreground="{DynamicResource BrushMuted}" />
          </DockPanel>

          <Border Background="{DynamicResource BrushRow}" CornerRadius="12" Padding="16,14"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.ApplyingNow]}"
                         FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding CurrentActionTitle}" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CurrentActionDetail}" FontSize="12"
                         Foreground="{DynamicResource BrushSecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.Cancel]}"
                  Command="{Binding CancelApplyCommand}"
                  Style="{StaticResource SecondaryBlueButton}"
                  HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="140" Height="36" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ========== FASE RESULTADO (centrado real) ========== -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="20"
          Visibility="{Binding IsDonePhase, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource BrushBg}"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border MaxWidth="640" MinWidth="280" Margin="24"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{DynamicResource BrushSurface}" CornerRadius="18"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="32,36">
        <StackPanel HorizontalAlignment="Stretch">
          <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16"
                  Background="#223DDC97" BorderBrush="#FF3DDC97" BorderThickness="2"
                  Visibility="{Binding HasApplyErrors, Converter={StaticResource InvertBool}}">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                       Foreground="#FF3DDC97" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16"
                  Background="#33F0A202" BorderBrush="#FFF0A202" BorderThickness="2"
                  Visibility="{Binding HasApplyErrors, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                       Foreground="#FFF0A202" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding ResultHeadline}" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Text="{Binding ResultSubtitle}" FontSize="14"
                     Foreground="{DynamicResource BrushSecondaryText}" HorizontalAlignment="Center"
                     TextAlignment="Center" Margin="0,8,0,16" TextWrapping="Wrap" />

          <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Background="#223DDC97" CornerRadius="10" Padding="14,8" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.ResultOk]}" FontSize="12"
                           Foreground="{DynamicResource BrushMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ApplyOkCount}" FontSize="18" FontWeight="Bold" Foreground="#FF3DDC97" />
              </StackPanel>
            </Border>
            <Border Background="#33F0A202" CornerRadius="10" Padding="14,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.ResultFail]}" FontSize="12"
                           Foreground="{DynamicResource BrushMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ApplyFailCount}" FontSize="18" FontWeight="Bold" Foreground="#FFF0A202" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <Border Background="{DynamicResource BrushRow}" CornerRadius="12" Padding="14" MaxHeight="180"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding FinalReport}" FontSize="12" Foreground="{DynamicResource BrushSecondaryText}"
                         TextWrapping="Wrap" LineHeight="18" />
            </ScrollViewer>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Beast.BackToPlan]}"
                    Command="{Binding BackToPlanCommand}" Style="{StaticResource SecondaryBlueButton}" Margin="0,0,8,0" />
            <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Optimize.NewAnalysis]}"
                    Style="{StaticResource HeaderActionButton}" Click="BtnAnalyze_OnClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>
