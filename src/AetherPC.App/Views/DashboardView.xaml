<UserControl x:Class="AetherPC.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:AetherPC.App.Services">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel HorizontalAlignment="Stretch">
      <Border Style="{StaticResource PageHeaderBar}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Style="{StaticResource PageHeaderTextColumn}">
            <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Page.Home]}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Home.Blurb]}" Style="{StaticResource PageBlurb}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HardwareProfileSummary}" Foreground="{DynamicResource BrushAccent}"
                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Grid.Column="1" Style="{StaticResource ButtonRowPanel}" VerticalAlignment="Top" HorizontalAlignment="Right">
            <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.Cancel]}" Command="{Binding CancelAnalysisCommand}"
                    Style="{StaticResource TertiaryButton}" Margin="0,0,6,6" IsEnabled="{Binding CanCancel}" />
            <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.Analyze]}" Command="{Binding RefreshCommand}"
                    Style="{StaticResource HeaderActionButton}" Margin="0,0,0,6" />
          </WrapPanel>
        </Grid>
      </Border>

      <ProgressBar Height="6" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,0,0,4"
                   Foreground="{DynamicResource BrushOk}"
                   Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
      <TextBlock Text="{Binding ProgressStage}" Style="{StaticResource MutedText}" Margin="0,0,0,12" FontSize="12"
                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />

      <UniformGrid Columns="4">
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Home.Health]}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding HealthScoreText}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource BrushOk}" />
            <TextBlock Text="{Binding HealthScoreHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="CPU" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
            <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
            <ProgressBar Height="6" Margin="0,10,0,0" Maximum="100" Value="{Binding CpuUsage}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="RAM" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding RamUsage, StringFormat={}{0:F0}%}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
            <TextBlock Text="{Binding RamDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            <ProgressBar Height="6" Margin="0,10,0,0" Maximum="100" Value="{Binding RamUsage}"
                         Foreground="{DynamicResource BrushOk}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Home.Temperature]}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding TempLabel}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarn}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GpuName}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <UniformGrid Columns="2">
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Home.Storage]}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
            <TextBlock Text="{Binding DiskSummary}" Margin="0,8,0,0" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding OsSummary}" Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Home.NetworkSecurity]}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding NetworkSummary}" Margin="0,8,0,0" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SecuritySummary}" Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource GlassCard}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Home.Recommendations]}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Recommendations}" MaxHeight="320"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Padding="12" CornerRadius="10"
                          Background="{DynamicResource BrushSurfaceSoft}"
                          BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Problem}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RiskDisplay}" FontSize="12"
                                 Foreground="{DynamicResource BrushWarn}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource GlassCard}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Home.HealthFactors]}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Factors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                    <DockPanel>
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" Foreground="{DynamicResource BrushOk}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ProgressBar Height="5" Maximum="100" Value="{Binding Score}" Margin="0,4,0,0"
                                 Foreground="{DynamicResource BrushOk}"
                                 IsEnabled="{Binding IsAvailable}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
