<UserControl x:Class="AetherPC.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:AetherPC.App.Services"
             xmlns:conv="clr-namespace:AetherPC.App.Converters"
             Loaded="CleanupView_OnLoaded">
  <UserControl.Resources>
    <conv:InverseBoolConverter x:Key="InvertBool" />
  </UserControl.Resources>
  <Grid HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Page.Cleanup]}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Cleanup.Blurb]}" />
          <TextBlock Text="{Binding LastResult}" Margin="0,10,0,0" Foreground="{DynamicResource BrushOk}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="168">
          <Button x:Name="BtnScan" Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.Scan]}"
                  Style="{StaticResource HeaderActionButton}" HorizontalAlignment="Stretch"
                  Margin="0,0,0,8" Click="BtnScan_OnClick"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
          <Button x:Name="BtnCleanSafe" Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Cleanup.SafeOnly]}"
                  Style="{StaticResource ActionChipButton}" HorizontalAlignment="Stretch"
                  Margin="0,0,0,8" Click="BtnCleanSafe_OnClick"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                  ToolTip="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Cleanup.SafeTip]}" />
          <Button x:Name="BtnCleanSelected" Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Cleanup.Selected]}"
                  Style="{StaticResource HeaderSuccessButton}" HorizontalAlignment="Stretch"
                  Click="BtnCleanSelected_OnClick"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                  ToolTip="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Cleanup.SelectedTip]}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" CornerRadius="12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Candidates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource BrushRow}" CornerRadius="10" Margin="4,3" Padding="12,10"
                      BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4,12,0" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
                    <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource BrushSecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5" />
                    <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#FF6B7C93" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
