<Window x:Class="AetherPC.App.Views.AetherDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherPC"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="480"
        MinWidth="360"
        MaxWidth="720"
        MinHeight="180"
        MaxHeight="720"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border Margin="12" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}"
          Background="{DynamicResource BrushFooter}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="AccentBar" Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18,22,14">
        <DockPanel>
          <Border x:Name="KindBadge" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12"
                  Margin="0,0,14,0" VerticalAlignment="Center">
            <TextBlock x:Name="KindIcon" Text="i" FontSize="18" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="TitleBlock" Text="AetherPC" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable Display, Segoe UI" />
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360"
                    Padding="22,8,22,8" Margin="0,4,0,0">
        <TextBlock x:Name="MessageBlock" Text="" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushSecondaryText}" FontSize="13.5" LineHeight="20" />
      </ScrollViewer>

      <Border Grid.Row="2" Padding="18,12,18,18" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnCancel" Content="Cancel" Padding="18,10" Margin="0,0,10,0"
                  Cursor="Hand" Click="BtnCancel_OnClick"
                  Background="{DynamicResource BrushHover}" Foreground="{DynamicResource BrushText}" BorderThickness="0"
                  FontWeight="SemiBold">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushChip}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button x:Name="BtnPrimary" Content="OK" Padding="20,10" Cursor="Hand"
                  Click="BtnPrimary_OnClick" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
