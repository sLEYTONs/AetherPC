<UserControl x:Class="AetherPC.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:AetherPC.App.Services"
             xmlns:conv="clr-namespace:AetherPC.App.Converters"
             Loaded="DriversView_OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolConverter x:Key="InvertBool" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.DeviceManager]}"
                  Command="{Binding OpenDeviceManagerCommand}"
                  Style="{StaticResource SecondaryBlueButton}" Margin="0,0,8,0"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.WinUpdate]}"
                  Command="{Binding OpenWindowsUpdateCommand}"
                  Style="{StaticResource SecondaryBlueButton}" Margin="0,0,8,0"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
          <Button Content="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Common.Refresh]}" Command="{Binding LoadCommand}"
                  Style="{StaticResource HeaderActionButton}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Page.Drivers]}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.Blurb]}" Style="{StaticResource PageBlurb}" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock Text="{Binding SummaryLine}" Foreground="{DynamicResource BrushAccent}" FontSize="12" Margin="0,4,0,0"
                     TextWrapping="Wrap" />
          <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" CornerRadius="12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource AetherTableHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.Col.Device]}" Foreground="{DynamicResource BrushMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="1" Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.Col.Vendor]}" Foreground="{DynamicResource BrushMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="2" Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.Col.Version]}" Foreground="{DynamicResource BrushMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="3" Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.Col.Category]}" Foreground="{DynamicResource BrushMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="4" Text="{Binding Source={x:Static s:UiLoc.Instance}, Path=[Drivers.Col.Health]}" Foreground="{DynamicResource BrushMuted}" FontWeight="SemiBold" FontSize="11" />
          </Grid>
        </Border>
        <ListBox ItemsSource="{Binding Items}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="12,8" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#223BA4FF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Manufacturer}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding DriverVersion}" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="3" Text="{Binding Category}" Foreground="{DynamicResource BrushAccent}" FontSize="11" />
                <Border Grid.Column="4" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left"
                        Background="#223DDC97">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#223DDC97" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HealthLabel}" Value="Attention">
                          <Setter Property="Background" Value="#33FF5C5C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HealthLabel}" Value="Old">
                          <Setter Property="Background" Value="#33F0A202" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HealthLabel}" Value="Unknown">
                          <Setter Property="Background" Value="#22000000" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding HealthLabel}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushText}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
