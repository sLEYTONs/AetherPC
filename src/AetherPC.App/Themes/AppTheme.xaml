            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
